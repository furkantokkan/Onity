/*
 * Onity screen fade cover. OnityScreenFadeView writes opacity, display and an optional background image inline;
 * the standalone document previews the fully covered state. Change the cover color here.
 */

.onity-screen-fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 1;
    display: flex;
}
